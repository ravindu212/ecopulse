# Production: use Neon's pooled hostname and include ?sslmode=require.
DATABASE_URL=postgresql+psycopg://ecopulse:ecopulse@localhost:5434/ecopulse
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development

# Public climate providers (no API keys required)
CLIMATE_HTTP_TIMEOUT_SECONDS=10
CLIMATE_HTTP_MAX_RESPONSE_BYTES=2000000
CLIMATE_CO2_URL=https://gml.noaa.gov/webdata/ccgg/trends/co2/co2_trend_gl.csv
CLIMATE_CO2_TTL_SECONDS=21600
CLIMATE_CO2_HISTORY_LIMIT=60
CLIMATE_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events
CLIMATE_EVENTS_TTL_SECONDS=900
CLIMATE_ENSO_OBSERVATIONS_URL=https://www.cpc.ncep.noaa.gov/data/indices/wksst9120.for
CLIMATE_ENSO_OBSERVATIONS_TTL_SECONDS=21600
CLIMATE_ENSO_HISTORY_LIMIT=52
CLIMATE_GLOBAL_TEMPERATURE_URL=https://www.ncei.noaa.gov/data/noaa-global-surface-temperature/v6.1/access/timeseries/aravg.mon.land_ocean.90S.90N.v6.1.0.202607.asc
CLIMATE_GLOBAL_TEMPERATURE_TTL_SECONDS=43200
CLIMATE_GLOBAL_TEMPERATURE_HISTORY_LIMIT=60
